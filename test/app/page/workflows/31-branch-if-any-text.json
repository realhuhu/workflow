        "BRANCH B": [
          {
            "action": "click",
            "runConfig": {
              "finishUntilList": [
                {
                  "type": "Image",
                  "target": "fixtures/marker-b.png",
                  "config": {
                    "threshold": 0.98,
                    "interval": 0.12,
                    "timeout": 8,
                    "region": {"x": 20, "y": 120, "width": 960, "height": 660}
                  }
                }
              ],
              "homing": false
