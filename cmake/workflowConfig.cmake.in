@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(Qt5 5.15.2 EXACT COMPONENTS Core)
find_dependency(OpenCV 4.10 EXACT COMPONENTS core imgproc imgcodecs)

include("${CMAKE_CURRENT_LIST_DIR}/workflowTargets.cmake")

# workflow::onnxruntime is exported as an interface target so that build-tree
# paths never leak into the installed package. Bind it to the bundled import
# library after PACKAGE_PREFIX_DIR has been resolved.
set_property(TARGET workflow::onnxruntime PROPERTY INTERFACE_LINK_LIBRARIES
        "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/onnxruntime.lib")

set(WORKFLOW_PACKAGE_ROOT "${PACKAGE_PREFIX_DIR}")
set(WORKFLOW_RUNTIME_DIRECTORY
        "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_BINDIR@")
set(WORKFLOW_MODELS_DIRECTORY
        "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_DATADIR@/workflow/models")
set(WORKFLOW_LICENSES_DIRECTORY
        "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_DATADIR@/workflow/licenses")
set(WORKFLOW_WINDOWS_MANIFEST
        "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_DATADIR@/workflow/windows/workflow-windows.manifest")

include("${CMAKE_CURRENT_LIST_DIR}/WorkflowRuntime.cmake")

check_required_components(workflow)
